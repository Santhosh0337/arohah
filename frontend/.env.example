# Public, build-time. Never put a secret in a VITE_ variable: it ships to the browser.
VITE_API_BASE_URL=http://localhost:8000

# Dev only. While Gnani has not confirmed Prisma for any language, every language
# in the dropdown is disabled. "true" enables the unconfirmed ones so the form and
# the fixture preview can be tried. It does NOT make Prisma work. Remove it (or set
# it to false) once languages are confirmed.
VITE_ALLOW_UNVERIFIED_LANGUAGES=true
